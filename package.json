{
  "name": "alpha-chain-phaser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alpha Chain — a high-velocity word-chain + engine-builder game, ported to Phaser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:game": "node scripts/export-game.mjs",
    "export:game:install": "node scripts/export-game.mjs --out ../../KnockBox-Games/games"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.5.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
